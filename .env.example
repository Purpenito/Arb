APP_NAME=arb-scanner
ENV=dev
LOG_LEVEL=INFO
POSTGRES_DSN=postgresql+asyncpg://arb:arb@db:5432/arb
REDIS_URL=redis://redis:6379/0
QUOTE_STALE_MS=3000
EXECUTION_BUFFER_PCT=0.03
BASIS_RISK_BUFFER_PCT=0.02
DEFAULT_SLIPPAGE_BPS=2.0
COLLECTOR_INTERVAL_SECONDS=5
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
